# Copy to server/.env and fill in. Every value is optional for local
# development — with no .env at all the app runs on the local engine.

# ---------------------------------------------------------------- AI engine
# Enables LLM extraction, written recommendations, and vision OCR for scans.
# The key stays server-side and is never sent to the browser.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model overrides. Defaults live in server/src/lib/gemini.ts; change these if
# the model names move.
# GEMINI_EXTRACT_MODEL=gemini-flash-lite-latest
# GEMINI_REASON_MODEL=gemini-flash-latest
# GEMINI_EMBED_MODEL=gemini-embedding-001

# ------------------------------------------------------------------- auth
# REQUIRED IN PRODUCTION — the server refuses to start without it.
# Sessions are server-side records keyed by an opaque cookie, so this is not a
# JWT signing key; it is reserved for cookie signing and future key rotation.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Public origin of the app. Used for CORS, and to build the links in
# verification and password-reset emails. REQUIRED IN PRODUCTION.
APP_URL=http://localhost:5173

# Set when running behind a reverse proxy so rate limiting sees the real client
# IP and HTTPS enforcement can tell that TLS was terminated upstream. "true" or
# "1" trusts one hop; a larger number trusts that many; a comma-separated list
# of addresses or subnets trusts exactly those. Leave unset when there is no
# proxy — trusting the header without one lets a client spoof its IP and bypass
# the limiter. Most managed hosts (Render, Railway, Fly, Heroku) put exactly one
# proxy in front of you, so "1" is the answer there.
# TRUST_PROXY=true

# --------------------------------------------------------------- deployment
# Bind address. Defaults to 127.0.0.1 in production so the API is reachable
# only through the reverse proxy. Setting 0.0.0.0 in production is refused
# unless ALLOW_PUBLIC_BIND=1 is also set.
# BIND_HOST=127.0.0.1

# HTTPS is enforced automatically when NODE_ENV=production. Only set this if
# you are terminating TLS somewhere this process cannot observe.
# ENFORCE_HTTPS=false

# HSTS lifetime in seconds. Default 180 days.
# HSTS_MAX_AGE=15552000

# ------------------------------------------------------- abuse protection
# Analysis is the only path that costs money, so it is budgeted per resume
# rather than per request: one call with 60 files is 60 extractions and up to
# 120 model calls. Defaults suit real recruiting volume.
# QUOTA_DAILY_RESUMES=500
# QUOTA_HOURLY_RESUMES=150
# QUOTA_CONCURRENT_BATCHES=2
# QUOTA_MAX_BATCH=60

# ------------------------------------------------------------------ logging
# debug | info | warn | error. Defaults to info in production.
# LOG_LEVEL=info

# Append security events to their own file as well as stdout, so they survive
# rotation of the general log and can be shipped to a SIEM separately.
# SECURITY_LOG_FILE=/var/log/resumeai/security.log

# ------------------------------------------------------------------- mail
# Verification and reset links are emailed. With no webhook configured the
# message is printed to the server log instead, which is fine for local
# development — the link is right there in the console.
# MAIL_WEBHOOK_URL=https://your-provider.example/send
# MAIL_FROM=no-reply@yourdomain.com

# ------------------------------------------------------------- demo login
# A single button on the sign-in page that opens one shared, pre-verified
# workspace — handy for showing the app without an inbox round trip. On by
# default; everyone who clicks it lands in the SAME account and sees the same
# candidates, so treat anything uploaded there as public.
# DEMO_LOGIN=false
# DEMO_EMAIL=demo@resumeai.local

# ------------------------------------------------------------ Google SSO
# OFF in this build. Google sign-in needs BOTH a client id below and
# GOOGLE_LOGIN=on; with either missing the button is hidden entirely,
# /api/auth/google answers 404, and email + password still works.
# GOOGLE_LOGIN=on
#
# To enable it:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create Credentials -> OAuth client ID -> Web application
#   3. Authorised JavaScript origins:  http://localhost:5173
#      (add your production origin too when you deploy)
#   4. Paste the Client ID below. The client SECRET is not used by this flow
#      and must not be put here.
GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------- server
# API port. The Vite dev proxy expects 5174.
# PORT=5174

# Per-file upload ceiling in megabytes.
# MAX_FILE_MB=12
